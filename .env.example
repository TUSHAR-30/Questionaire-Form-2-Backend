# Copy this file to `.env` for local development. NEVER commit the real `.env`.
# On a host (Render/Vercel), set these same names in its Environment Variables settings instead.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT: set DEV=local. The server then uses the *_LOCAL values below
# for the database, frontend URL and backend URL.
# PRODUCTION: do NOT set DEV (or set it to anything except "local"). The server then uses
# CONN_STR, FRONTEND_URL and BACKEND_URL directly (see the Production section).
DEV=local

PORT=8000

# ---------------------------------------------------------------------------
# Local development values (used only when DEV=local)
# ---------------------------------------------------------------------------
LOCAL_CONN_STR=mongodb://127.0.0.1:27017/questionnaireApp
FRONTEND_URL_LOCAL=http://localhost:5173
# Includes the /api suffix; used for the Google OAuth callback addresses
BACKEND_URL_LOCAL=http://localhost:8000/api

# ---------------------------------------------------------------------------
# Production values (set these on the host; ignored when DEV=local)
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string
CONN_STR=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Your deployed frontend, no trailing slash. Used for CORS and post-login redirects.
FRONTEND_URL=https://your-frontend.vercel.app
# Your deployed backend INCLUDING the /api suffix. Used for the Google OAuth callback addresses.
BACKEND_URL=https://your-backend.onrender.com/api

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Long random string used to sign login cookies. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login token lasts (jsonwebtoken format, e.g. 5d, 12h)
LOGIN_EXPIRES=5d
# How long the login cookie lasts, in days
COOKIE_EXPIRE=5

# ---------------------------------------------------------------------------
# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client)
# Authorized redirect URIs must include, for each backend URL you use:
#   <BACKEND_URL>/auth/google/callback
#   <BACKEND_URL>/selectAccount/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------------------------------------------------------------------------
# Email (sends the signup OTP)
# Use a Gmail address with 2-Step Verification on, and a Google "App Password"
# (Google Account > Security > App passwords): 16 characters, no spaces.
# ---------------------------------------------------------------------------
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your16charapppassword

# ---------------------------------------------------------------------------
# AI question assistant
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
